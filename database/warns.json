`;

// ==========================================
// FUNÇÃO PRINCIPAL — INTERPRETAR COMANDOS
// ==========================================

function processarComando(mensagem, numeroCliente) {
  const cmd = mensagem.trim().toLowerCase();

  // 🏠 MENU PRINCIPAL
  if (/^\/?(inicio|menu|ola|oi|olá|bom dia|boa tarde|boa noite)$/.test(cmd)) {
    return `
👋 Olá! Seja bem-vindo(a) à *${LOJA.nome}*! 😊

Escolha uma opção:
📦 /catalogo — Ver produtos e preços
🔥 /ofertas — Promoções ativas
🚚 /entrega — Prazos e frete
💳 /pagamento — Formas de pagamento
📝 /pedido — Como fazer um pedido
❓ /ajuda — Falar com a gente

Em que posso ajudar?
    `;
  }

  // 📦 CATÁLOGO
  if (/^\/?(catalogo|produtos|precos|lista)$/.test(cmd)) {
    return PRODUTOS;
  }

  // 🔥 OFERTAS
  if (/^\/?(ofertas|promocoes|desconto|cupom)$/.test(cmd)) {
    return OFERTAS;
  

Qualquer dúvida é só chamar! 😊
    `;
  }

  // 💳 PAGAMENTO
  if (/^\/?(pagamento|pagar|pix|cartao)$/.test(cmd)) {
    return `
💳 *FORMAS DE PAGAMENTO*

✅ Pix — 0% de desconto → Chave: ${LOJA.pix}

📌 Pedido confirmado após confirmação do pagamento!
    `;
  }

  // 📝 COMO PEDIR
  if (/^\/?(pedido|comprar|como pedir|fazer pedido)$/.test(cmd)) {
    return `
📝 *COMO PEDIR* — Super simples! 😊

1️⃣ Digite o nome ou número do produto
2️⃣ Informe a quantidade
3️⃣ Nos envie seu endereço completo
4️⃣ Escolha a forma de pagamento
5️⃣ Pronto! ✅

Exemplo: "Quero 1x Produto A para Rua X, 123 — Bauru/SP"
    `;
  }

  // ❓ AJUDA / FALAR COM ATENDENTE
  if (/^\/?(ajuda|suporte|contato|atendente|falar com alguem)$/.test(cmd)) {
    return `
📞 *FALE COM A GENTE*

⏰ Atendimento: ${LOJA.horario}
📍 ${LOJA.endereco}

💬 Estamos te encaminhando para um atendente...
Em breve alguém responde você! Obrigado pela paciência 🙏
    `;
  }

  // ❓ COMANDO NÃO RECONHECIDO
  return `
🤔 Desculpe, não entendi!

Use os comandos abaixo:
📦 /catalogo | 🔥 /ofertas | 🚚 /entrega
💳 /pagamento | 📝 /pedido | ❓ /ajuda

Ou é só digitar /menu para ver tudo! 😊
  `;
}

